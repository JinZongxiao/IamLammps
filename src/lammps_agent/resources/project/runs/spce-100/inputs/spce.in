# Fast integration sample, not a converged water-property calculation.
# 100 rigid SPC/E molecules near 1 g/cm^3; real units use fs and kcal/mol.

units real
atom_style full
boundary p p p

region box block 0.0 14.42 0.0 14.42 0.0 14.42 units box
create_box 2 box bond/types 1 angle/types 1 &
  extra/bond/per/atom 2 extra/angle/per/atom 1 extra/special/per/atom 2
molecule spce spce.mol
create_atoms 0 random 100 24681357 box mol spce 13579 overlap 1.8 maxtry 100000

mass 1 15.9994
mass 2 1.00794
pair_style lj/cut/coul/long 6.5
pair_coeff 1 1 0.1553 3.166
pair_coeff 1 2 0.0 1.0
pair_coeff 2 2 0.0 1.0
bond_style harmonic
bond_coeff 1 1000.0 1.0
angle_style harmonic
angle_coeff 1 100.0 109.47
special_bonds lj/coul 0.0 0.0 0.0
kspace_style pppm 1.0e-4

neighbor 2.0 bin
neigh_modify every 1 delay 0 check yes
timestep 1.0
thermo 100
thermo_style custom step temp press density pe ke etotal

fix constraints all shake 1.0e-4 20 0 b 1 a 1
velocity all create 300.0 97531 mom yes rot yes dist gaussian
fix thermostat all nvt temp 300.0 300.0 100.0
run 3000
unfix thermostat

reset_timestep 0
compute rdf_oo all rdf 100 1 1
fix rdf_output all ave/time 100 20 2000 c_rdf_oo[*] file rdf_oo.dat mode vector
fix production all nve
run 2000

unfix production
unfix rdf_output
unfix constraints
