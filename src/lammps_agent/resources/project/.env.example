# Model provider: openai_agents or deepseek
LLM_PROVIDER=openai_agents

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_REASONING_EFFORT=medium
OPENAI_TRACING=false

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Local execution
LAMMPS_COMMAND=lmp
# LAMMPS_TIMEOUT=600
# MPI_NP=4
# LAMMPS_POTENTIALS_DIR=

# Deterministic post-processing analyzers
ENABLED_ANALYZERS=thermo_tail,convergence,thermo_validator
