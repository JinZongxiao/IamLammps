# === LLM 配置 ===
# 选择 LLM 后端: openai_compatible 或 local_ollama
LLM_PROVIDER=openai_compatible

# OpenAI 兼容接口（也适用于 ERNIE/vLLM/TGI/LM Studio 等兼容 /v1/chat/completions 的服务）
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# 本地 Ollama
LOCAL_BASE_URL=http://127.0.0.1:11434
LOCAL_MODEL=qwen2.5:7b

# === LAMMPS 配置 ===
LAMMPS_COMMAND=lmp_mpi
# LAMMPS_TIMEOUT=600                    # 单次执行超时（秒），留空不限时
# MPI_NP=4                              # MPI 进程数，留空单进程
# LAMMPS_POTENTIALS_DIR=                 # 势函数目录，留空自动发现 LAMMPS 安装路径

# === Agent 行为 ===
MAX_RETRIES=3                            # LAMMPS 错误自动重试次数

# === 后处理 Skills ===
# 默认启用基础 skills；力学性能 skills 在 workflow 模式下按需启用
ENABLED_SKILLS=thermo_tail,convergence,thermo_validator
# 可用 skills:
#   thermo_tail       - thermo 表尾部提取
#   convergence       - 能量/温度收敛性检查
#   thermo_validator  - 物理量合理范围检查
#   stress_strain     - 应力-应变曲线分析（E, σ_y, UTS）
#   indent_analysis   - Oliver-Pharr 纳米压痕分析（H, E_r）
#   crack_analysis    - 裂纹 Mode I 分析（σ_max, K_IC）
#   dbtt_fit          - Boltzmann sigmoid 拟合 DBTT

# === 模拟记忆 ===
MEMORY_FILE=runs/simulation_memory.jsonl
MEMORY_MAX_ENTRIES=200
MEMORY_CONTEXT_CHARS=2400
